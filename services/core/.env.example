# Copy to `.env` and adjust. Every setting is optional; defaults are shown.
# Full reference: docs/configuration.md

# --- Server -------------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false

# --- Persona ------------------------------------------------------------------
JARVIS_USER_NAME=Ryan
JARVIS_ASSISTANT_NAME=Jarvis
JARVIS_GREETING_TEMPLATE="How can I help you {user_name}?"

# --- Wake word (openwakeword | none) -----------------------------------------
JARVIS_WAKE_ENGINE=openwakeword
# A pretrained name ("hey_jarvis") or a path to your own "hello_jarvis.onnx".
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.5

# --- Listening / end-of-speech detection (webrtc | energy) -------------------
# webrtc (light) | silero (neural, best in noise) | energy (no deps)
JARVIS_VAD_ENGINE=webrtc
JARVIS_VAD_AGGRESSIVENESS=2
JARVIS_END_OF_SPEECH_MS=800
JARVIS_LISTEN_TIMEOUT_MS=6000
JARVIS_FOLLOW_UP_MS=6000
JARVIS_MAX_UTTERANCE_MS=15000

# --- Barge-in & playback (wake_word | voice | off) ---------------------------
JARVIS_BARGE_IN=wake_word
JARVIS_BARGE_IN_MIN_SPEECH_MS=400
JARVIS_PLAYBACK_GRACE_MS=4000

# --- Voice ID (needs: uv sync --extra voice --extra speaker) -----------------
JARVIS_SPEAKER_VERIFICATION=false
JARVIS_SPEAKER_THRESHOLD=0.30
JARVIS_SPEAKER_ENROLLMENT_SAMPLES=3

# --- Speech-to-text (faster_whisper | none) ----------------------------------
JARVIS_STT_ENGINE=faster_whisper
JARVIS_STT_MODEL=base.en
JARVIS_STT_DEVICE=auto
JARVIS_STT_COMPUTE_TYPE=int8

# --- Language model (Ollama) ---------------------------------------------------
JARVIS_LLM_BASE_URL=http://127.0.0.1:11434
JARVIS_LLM_MODEL=llama3.2:3b
JARVIS_LLM_TEMPERATURE=0.6
JARVIS_HISTORY_MESSAGES=20

# --- Brain: tools, memory, knowledge ----------------------------------------
JARVIS_TOOLS_ENABLED=true
JARVIS_MAX_TOOL_ROUNDS=4
# auto = attach only the tools a request needs (much faster on CPU) | all
JARVIS_TOOL_ROUTING=auto
JARVIS_TOOL_ROUTING_MAX_TOOLS=6
JARVIS_MEMORY_ENABLED=true
JARVIS_EMBEDDING_MODEL=nomic-embed-text
JARVIS_WEATHER_ENABLED=true
JARVIS_DEFAULT_LOCATION=
JARVIS_ENCYCLOPEDIA_ENABLED=true
# Wikimedia asks for contact info in the User-Agent (https://w.wiki/4wJS).
# JARVIS_ENCYCLOPEDIA_USER_AGENT="JarvisOS/0.2 (+https://github.com/you/jarvis-os) python-httpx"
# Self-hosted SearXNG, e.g. http://127.0.0.1:8888 (see docs/guides/web-search.md)
JARVIS_SEARXNG_URL=
# Folder of notes to search, e.g. C:/Users/ryan/Documents/Notes
JARVIS_DOCUMENTS_DIR=
# JSON list of MCP servers (see docs/guides/mcp.md)
JARVIS_MCP_SERVERS=[]
JARVIS_PERSONA_FORMALITY=balanced
JARVIS_PERSONA_VERBOSITY=balanced
JARVIS_PERSONA_HUMOUR=dry

# --- Dashboard data & briefing (also editable live in Settings) ---------------
# JARVIS_NEWS_FEEDS=["https://feeds.bbci.co.uk/news/world/rss.xml","https://feeds.npr.org/1001/rss.xml"]
# Secret ICS addresses (treat like passwords) or .ics file paths:
# JARVIS_CALENDAR_URLS=["https://calendar.google.com/calendar/ical/.../basic.ics"]
# Daily spoken briefing (HH:MM, empty = off):
JARVIS_BRIEFING_TIME=
JARVIS_SYSTEM_MONITOR_ENABLED=true

# --- Phone access (Tailscale) — see docs/guides/phone-access.md ----------------
# The core serves the built dashboard at / for phones. Empty = apps/desktop/dist
# (build it with: pnpm --filter @jarvis/desktop build).
# JARVIS_WEB_DIST=

# --- PisoTiyempo stock portfolio (PSE) — see docs/guides/pisotiyempo.md -------
# Its desktop feed defaults to port 8765 (Jarvis's port): set feedPort=8766 in
# %APPDATA%\PisoTiyempo\config.properties. Empty URL = read export files only.
JARVIS_PORTFOLIO_ENABLED=true
JARVIS_PORTFOLIO_FEED_URL=http://127.0.0.1:8766
# JARVIS_PORTFOLIO_EXPORT_DIR=C:\Users\you\AppData\Roaming\PisoTiyempo\export
# Speak your PisoTiyempo alerts (read-only from its database):
JARVIS_PORTFOLIO_ALERTS_ENABLED=true
# JARVIS_PORTFOLIO_DATABASE=C:\Users\you\AppData\Roaming\PisoTiyempo\piso-tiyempo.db

# Reasoning models only: false = skip thinking for faster answers
# JARVIS_LLM_THINK=false

# --- Storage -------------------------------------------------------------------
# JARVIS_DATA_DIR=C:/Users/ryan/.jarvis-os

# --- Text-to-speech (kokoro | none) ------------------------------------------
JARVIS_TTS_ENGINE=kokoro
# British English ("b") + a British male voice suits the character.
JARVIS_TTS_LANG_CODE=b
JARVIS_TTS_VOICE=bm_george
JARVIS_TTS_SPEED=1.0
