{
  "name": "jarvis-os",
  "version": "0.3.0",
  "private": true,
  "description": "Jarvis OS — a personal, voice-driven AI dashboard.",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @jarvis/desktop dev",
    "dev:core": "uv run --directory services/core jarvis-core",
    "dev:app": "pnpm --filter @jarvis/desktop tauri dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "mkdocs serve"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
